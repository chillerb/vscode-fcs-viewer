// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "claude-code-dev",

	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/python:3-3.14-trixie",
	"features": {
		"ghcr.io/devcontainers-extra/features/uv:1": {},
		// "ghcr.io/devcontainers-extra/features/claude-code:2": {},

		// ...or install the official feature, which also requires node
		"ghcr.io/devcontainers/features/node:2.1.0": {},
		"ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
	},

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Make claude conversations persistent across container rebuilds!
	"mounts": [
		// mount your local .claude directory
		// "type=bind,src=${localEnv:HOME}/.claude,dst=/home/vscode/.claude",
		// "type=bind,src=${localEnv:HOME}/.claude.json,dst=/home/vscode/.claude.json"

		// if connecting as root
		"type=bind,src=${localEnv:HOME}/.claude,dst=/root/.claude",
		"type=bind,src=${localEnv:HOME}/.claude.json,dst=/root/.claude.json"

		// mount a docker managed volume named "claude" which is shared across containers
		// "type=volume,src=claude,dst=/home/vscode/.claude"

		// if connecting as root
		// "type=volume,src=claude,dst=/root/.claude"
	],

	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "pip3 install --user -r requirements.txt",

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				"Anthropic.claude-code",
				"ms-vscode.extension-test-runner"
			]
		}
	},

	// for docker-rootless, connect as root
	"remoteUser": "root"
}