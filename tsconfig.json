{
  // Type-checks the extension host + shared code. Emits nothing; esbuild builds dist/.
  // NOTE: lib must NOT include DOM -- host code referencing `window` would crash at runtime.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/extension/**/*", "src/common/**/*"]
}
